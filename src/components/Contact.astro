---
import ContactForm from "./ContactForm.tsx";

const contactLinks = [
  {
    label: "Email",
    href: "mailto:kifansanf@gmail.com",
    value: "kifansanf@gmail.com",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
    copyable: true,
    external: false,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/kifansanaufal",
    value: "linkedin.com/in/kifansanaufal",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/Kifansa",
    value: "github.com/Kifansa",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    external: true,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/kifansa",
    value: "instagram.com/kifansa",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
    external: true,
  },
];
---

<section id="contact" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="reveal text-sm font-medium uppercase tracking-wider mb-2" style="color: var(--accent);">
        Let's Connect
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Get In Touch
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
      <p class="reveal reveal-delay-2 max-w-lg mx-auto text-base" style="color: var(--text-muted);">
        Interested in collaborating or have a question? Feel free to reach out through any
        of the channels below or send me a message directly.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10">
      <!-- Contact Links -->
      <div class="reveal reveal-delay-2 space-y-4">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="contact-btn card flex items-center gap-4 group cursor-pointer"
              data-copyable={link.copyable ? link.value : undefined}
            >
              <div
                class="flex items-center justify-center w-12 h-12 rounded-lg shrink-0 transition-colors duration-200"
                style="background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent);"
              >
                <Fragment set:html={link.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold" style="color: var(--text);">{link.label}</p>
                <p class="text-sm truncate" style="color: var(--text-muted);">{link.value}</p>
              </div>
              {link.copyable ? (
                <button
                  type="button"
                  class="copy-btn shrink-0 p-2 rounded-lg border transition-all duration-200"
                  style="border-color: var(--border); color: var(--text-muted);"
                  data-copy={link.value}
                  aria-label={`Copy ${link.value}`}
                  onclick="event.preventDefault(); event.stopPropagation();"
                >
                  <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <svg class="check-icon hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              ) : (
                <span class="shrink-0" style="color: var(--text-muted);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </span>
              )}
            </a>
          ))
        }
      </div>

      <!-- Contact Form -->
      <div class="reveal reveal-delay-3">
        <div class="card">
          <h3 class="font-heading font-semibold text-lg mb-4" style="color: var(--text);">
            Send a Message
          </h3>
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Copy to clipboard functionality
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const text = btn.getAttribute("data-copy");
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector(".copy-icon");
        const checkIcon = btn.querySelector(".check-icon");
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");
        btn.style.color = "var(--accent)";
        btn.style.borderColor = "var(--accent)";

        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
          btn.style.color = "var(--text-muted)";
          btn.style.borderColor = "var(--border)";
        }, 2000);
      } catch (err) {
        // Fallback: open mailto
        window.location.href = "mailto:" + text;
      }
    });
  });
</script>
