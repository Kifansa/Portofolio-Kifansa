---
import { skillCategories } from "../data/skills";
---

<section id="skills" class="py-16 sm:py-20 lg:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-14">
      <p class="reveal text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">
        Technical Toolkit
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Skills & Analytics Stack
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
      <p class="reveal reveal-delay-2 max-w-xl mx-auto text-sm sm:text-base" style="color: var(--text-muted);">
        A specialized toolkit honed for high-volume data analysis, machine learning workflows, and interactive executive reporting.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {
        skillCategories.map((category, catIdx) => (
          <div
            class={`reveal-scale reveal-delay-${catIdx + 1} card rounded-3xl group p-4 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:border-sky-500 hover:shadow-xl`}
            style="background: color-mix(in srgb, var(--accent) 3%, var(--bg-surface)); border-color: var(--border);"
          >
            <div>
              <div class="flex items-center gap-3 mb-5 pb-3 border-b" style="border-color: var(--border);">
                <div
                  class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 shadow-sm"
                  style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, transparent), color-mix(in srgb, var(--accent-secondary) 10%, transparent)); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);"
                >
                  {category.icon === "database" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                  )}
                  {category.icon === "chart" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                  )}
                  {category.icon === "code" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  )}
                  {category.icon === "briefcase" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
                  )}
                </div>
                <h3
                  class="font-heading font-bold text-sm sm:text-base"
                  style="color: var(--text);"
                >
                  {category.name}
                </h3>
              </div>

              <div class="flex flex-wrap gap-2">
                {category.skills.map((skill) => (
                  <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 hover:scale-105 shadow-sm"
                    style="background: color-mix(in srgb, var(--accent) 6%, var(--bg-surface)); color: var(--text); border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));"
                  >
                    {/* Tool Brand Logos (Latest Official Transparent Vector SVGs) */}
                    {skill.icon === "python" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                        <path fill="#3776AB" d="M11.91 0C5.7 0 6.07 2.68 6.07 2.68l.01 2.78h5.92v.84H3.92S0 5.84 0 12.07c0 6.22 3.44 6 3.44 6h2.05v-2.88s-.11-3.44 3.39-3.44h5.83s3.28.05 3.28-3.21V2.68S18.37 0 11.91 0zm-3.23 1.84a1.07 1.07 0 1 1 0 2.14 1.07 1.07 0 0 1 0-2.14z"/>
                        <path fill="#FFD43B" d="M12.09 24c6.21 0 5.84-2.68 5.84-2.68l-.01-2.78H12v-.84h8.08s3.92.46 3.92-5.77c0-6.22-3.44-6-3.44-6h-2.05v2.88s.11 3.44-3.39 3.44H9.29s-3.28-.05-3.28 3.21v5.86s-.39 2.68 6.08 2.68zm3.23-1.84a1.07 1.07 0 1 1 0-2.14 1.07 1.07 0 0 1 0 2.14z"/>
                      </svg>
                    )}
                    {skill.icon === "sql" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none">
                        <path fill="#336791" d="M12 2C6.48 2 2 4.01 2 6.5v11C2 19.99 6.48 22 12 22s10-2.01 10-4.5v-11C22 4.01 17.52 2 12 2zm0 2c4.42 0 8 1.34 8 2.5S16.42 9 12 9 4 7.66 4 6.5 7.58 4 12 4zm8 13.5c0 1.16-3.58 2.5-8 2.5s-8-1.34-8-2.5V14.2c2.03 1.11 4.88 1.8 8 1.8s5.97-.69 8-1.8v3.3zm0-5c0 1.16-3.58 2.5-8 2.5s-8-1.34-8-2.5V9.2c2.03 1.11 4.88 1.8 8 1.8s5.97-.69 8-1.8v3.3z"/>
                      </svg>
                    )}
                    {skill.icon === "pandas" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <rect x="2" y="10" width="3.5" height="11" rx="1" fill="#130754"/>
                        <rect x="7.5" y="5" width="3.5" height="16" rx="1" fill="#FFCA00"/>
                        <rect x="13" y="2" width="3.5" height="19" rx="1" fill="#E70488"/>
                        <rect x="18.5" y="8" width="3.5" height="13" rx="1" fill="#00A3E0"/>
                      </svg>
                    )}
                    {skill.icon === "numpy" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path fill="#013243" d="M12 2L3 7v10l9 5 9-5V7L12 2z"/>
                        <path fill="#4DABCF" d="M12 2.5l7.5 4.2-7.5 4.2L4.5 6.7 12 2.5z"/>
                        <path fill="#013243" d="M4 7.6l7.5 4.2v8.4L4 16V7.6z"/>
                        <path fill="#4D77CF" d="M12.5 11.8l7.5-4.2V16l-7.5 4.2v-8.4z"/>
                        <path fill="#FFFFFF" d="M8.5 10v4l2-2.5v2.5h1V10l-2 2.5V10h-1zm5 0v4h1.5c1 0 1.5-.5 1.5-1.2 0-.6-.4-1-1-1.1.5-.1.8-.5.8-.9 0-.6-.5-.8-1.3-.8H13.5zm1 1.5v-.8h.4c.3 0 .5.1.5.4s-.2.4-.5.4h-.4zm0 1.8v-.8h.5c.3 0 .6.1.6.4s-.3.4-.6.4h-.5z"/>
                      </svg>
                    )}
                    {skill.icon === "scikit" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <circle cx="8" cy="8" r="4" fill="#F89939"/>
                        <circle cx="16" cy="14" r="5" fill="#3499CD"/>
                        <circle cx="9" cy="17" r="3" fill="#F89939"/>
                        <path stroke="#1E293B" stroke-width="1.5" d="M8 8l8 6M16 14l-7 3M8 8l1 9"/>
                      </svg>
                    )}
                    {skill.icon === "jupyter" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path fill="#F37626" d="M12 4.2c3.8 0 7.1 2.2 8.7 5.5a10 10 0 0 0-17.4 0c1.6-3.3 4.9-5.5 8.7-5.5zm0 15.6c-3.8 0-7.1-2.2-8.7-5.5a10 10 0 0 0 17.4 0c-1.6 3.3-4.9 5.5-8.7 5.5z"/>
                        <circle cx="12" cy="1.8" r="1.5" fill="#767676"/>
                        <circle cx="3" cy="18" r="1.2" fill="#767676"/>
                        <circle cx="21" cy="6" r="1.2" fill="#767676"/>
                      </svg>
                    )}
                    {skill.icon === "tableau" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path fill="#EB762F" d="M11 1.5h2v4.8h-2zM11 17.7h2v4.8h-2zM1.5 11h4.8v2H1.5zM17.7 11h4.8v2h-4.8z"/>
                        <path fill="#4E79A7" d="M6.5 6.5h2v3.5h-2zM6.5 14h2v3.5h-2zM15.5 6.5h2v3.5h-2zM15.5 14h2v3.5h-2z"/>
                        <path fill="#E15759" d="M10.2 8.5h3.6v7h-3.6z"/>
                        <path fill="#59A14F" d="M3.5 3.5h1.5v2.5H3.5zM19 3.5h1.5v2.5H19zM3.5 18h1.5v2.5H3.5zM19 18h1.5v2.5H19z"/>
                      </svg>
                    )}
                    {skill.icon === "powerbi" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <rect x="2" y="11" width="4.5" height="11" rx="1.5" fill="#F2C811"/>
                        <rect x="8" y="6" width="5" height="16" rx="1.5" fill="#E6AD10"/>
                        <rect x="14.5" y="2" width="5.5" height="20" rx="1.5" fill="#D99400"/>
                        <path fill="#FFE066" d="M14.5 3.5c0-.83.67-1.5 1.5-1.5h2.5c.83 0 1.5.67 1.5 1.5v4H14.5v-4z"/>
                      </svg>
                    )}
                    {skill.icon === "datastudio" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <rect x="3" y="12" width="4.5" height="9" rx="2" fill="#4285F4"/>
                        <rect x="9.5" y="6" width="5" height="15" rx="2" fill="#0F9D58"/>
                        <rect x="16.5" y="2" width="4.5" height="19" rx="2" fill="#F4B400"/>
                      </svg>
                    )}
                    {skill.icon === "excel" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <rect x="5" y="2" width="16" height="20" rx="2" fill="#107C41"/>
                        <rect x="2" y="5" width="12" height="14" rx="2" fill="#21A366"/>
                        <path fill="#FFFFFF" d="M5.5 8l2.5 4-2.5 4h1.8l1.6-2.8 1.6 2.8h1.8L9.8 12l2.5-4h-1.8L8.9 10.8 7.3 8H5.5z"/>
                        <path fill="#185A37" d="M14 6h5v2h-5zM14 10h5v2h-5zM14 14h5v2h-5z"/>
                      </svg>
                    )}
                    {skill.icon === "java" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path fill="#5382A1" d="M9 19.5c3.5.2 6.5-.4 8.5-1.5-.5-.4-2 .2-3.8.3-2.5.1-5-.3-6.5-1.2-.5-.3-.7.2-.3.5.6.8 1.4 1.5 2.1 1.9z"/>
                        <path fill="#E76F00" d="M13.2 4.5c.8.9.8 1.8.3 2.7-.8 1.4-2.5 2.1-3.2 3.3-.4.8-.2 1.5.2 2.2-.8-.7-1.3-1.6-1.1-2.5.3-1.4 1.9-2.3 2.6-3.4.5-.8.5-1.5 0-2.3.4 0 .8 0 1.2 0z"/>
                        <path fill="#EA2D2E" d="M14.5 13c1.5.8 2.5 2.1 2.5 3.6 0 2.4-2.6 4.2-7 4.2-3.8 0-6.5-1.6-6.5-3.6 0-.9.5-1.7 1.4-2.2-.4-.2-.8.5-.4.8 1.3 1 3.2 1.6 5.5 1.6 4.3 0 6.5-1.6 6.5-3.2 0-1.4-.9-2.5-2-3-.5-.3-.8.1-.4.6z"/>
                      </svg>
                    )}
                    {skill.icon === "r" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <ellipse cx="12" cy="12" rx="10" ry="7.5" fill="#CBDBE9"/>
                        <ellipse cx="12.5" cy="12" rx="7.5" ry="5.5" fill="#FFFFFF"/>
                        <path fill="#276DC3" d="M9 7h4.5c2 0 3.5 1 3.5 2.8 0 1.5-1 2.5-2.5 2.7l3 4.5h-2.5l-2.7-4H11.2V17H9V7zm2.2 4.5h2.2c.8 0 1.3-.4 1.3-1.1s-.5-1.1-1.3-1.1h-2.2v2.2z"/>
                      </svg>
                    )}
                    {skill.icon === "github" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                    )}
                    {skill.icon === "htmlcss" && (
                      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                        <path fill="#E34F26" d="M3 2l1.6 18 7.4 2 7.4-2L21 2H3zm14.5 5.5H9.3l.2 2h7.8l-.6 6.5-4.7 1.3-4.7-1.3-.3-3.5h2l.1 1.8 2.9.8 2.9-.8.3-3.3H6.8l-.7-7.5h11.7l-.3 2z"/>
                      </svg>
                    )}
                    {skill.icon === "eda" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/>
                      </svg>
                    )}
                    {skill.icon === "stats" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 3v18h18"/><path d="M7 16c2-4 4-8 7-8s5 8 7 8"/>
                      </svg>
                    )}
                    {skill.icon === "dashboard" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
                      </svg>
                    )}
                    {skill.icon === "storytelling" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                      </svg>
                    )}
                    {skill.icon === "bi" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 20V10M18 20V4M6 20v-4"/>
                      </svg>
                    )}
                    {skill.icon === "abtest" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
                      </svg>
                    )}
                    {skill.icon === "process" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                      </svg>
                    )}
                    {skill.icon === "presentation" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 3h20v14H2zM8 21h8M12 17v4"/>
                      </svg>
                    )}
                    {skill.icon === "agile" && (
                      <svg class="w-3.5 h-3.5 shrink-0 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                      </svg>
                    )}

                    <span>{skill.name}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
