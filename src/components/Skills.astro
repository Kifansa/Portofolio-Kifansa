---
import { skillCategories } from "../data/skills";
---

<section id="skills" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="reveal text-sm font-medium uppercase tracking-wider mb-2" style="color: var(--accent);">
        What I Work With
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Skills & Tools
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        skillCategories.map((category, catIdx) => (
          <div
            class={`reveal reveal-delay-${catIdx + 1} card group`}
          >
            <h3
              class="text-sm font-semibold uppercase tracking-wider mb-4 pb-3"
              style={`color: var(--accent); border-bottom: 1px solid var(--border);`}
            >
              {category.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span
                  class="inline-block px-3 py-1.5 text-xs font-medium rounded-md transition-colors duration-200"
                  style="background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--text); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);"
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
