---
import ThemeToggle from "./ThemeToggle.tsx";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Education", href: "#education" },
  { label: "Skills", href: "#skills" },
  { label: "Certifications", href: "#certifications" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-200 py-3"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="navbar-container flex items-center justify-between h-14 px-4 sm:px-6 rounded-full transition-all duration-200 border border-transparent">
      <!-- Brand Logo -->
      <a
        href="#"
        class="flex items-center gap-2.5 group"
      >
        <div class="relative w-8 h-8 flex items-center justify-center shrink-0 transition-transform duration-200 group-hover:scale-105">
          <img
            src="/images/logo.webp"
            alt="Kifansa Logo"
            class="w-full h-full object-contain"
          />
        </div>
        <span
          class="font-heading text-base sm:text-lg font-bold tracking-tight transition-colors duration-200"
          style="color: var(--text);"
        >
          Kifansa
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1 lg:gap-1.5 p-1 rounded-full border" style="background: var(--bg-card); border-color: var(--border);">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link px-2.5 lg:px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200"
              style="color: var(--text-muted);"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Right side: Theme Toggle + Mobile Menu -->
      <div class="flex items-center gap-2">
        <ThemeToggle client:load />

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-full border transition-colors duration-200 touch-manipulation"
          style="color: var(--text-muted); background: var(--bg-card); border-color: var(--border);"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="close-icon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu Panel -->
    <div
      id="mobile-menu"
      class="md:hidden overflow-hidden transition-all duration-200 max-h-0 opacity-0 mt-2 rounded-2xl border"
      style="background: var(--bg-card); border-color: var(--border); box-shadow: var(--shadow-lg);"
    >
      <div class="p-3 space-y-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link block px-4 py-2.5 text-sm font-semibold rounded-xl transition-colors duration-200 touch-manipulation"
              style="color: var(--text-muted);"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<style>
  #navbar.scrolled .navbar-container {
    background: var(--bg-card);
    border-color: var(--border);
    box-shadow: var(--shadow);
    backdrop-filter: blur(24px) saturate(190%);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
  }

  .nav-link:hover,
  .mobile-nav-link:hover {
    color: var(--text) !important;
    background: var(--bg-surface-hover);
  }

  .nav-link.active {
    color: var(--text) !important;
    background: var(--bg-surface) !important;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
</style>

<script is:inline>
  (function () {
    const navbar = document.getElementById("navbar");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    let isOpen = false;

    function closeMenu() {
      if (!isOpen) return;
      isOpen = false;
      mobileMenu.style.maxHeight = "0";
      mobileMenu.style.opacity = "0";
      menuIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
      mobileBtn.setAttribute("aria-expanded", "false");
    }

    // Scroll effect
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });

    // Mobile menu toggle
    mobileBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen = !isOpen;
      mobileBtn.setAttribute("aria-expanded", isOpen.toString());
      if (isOpen) {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
        mobileMenu.style.opacity = "1";
        menuIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
      } else {
        closeMenu();
      }
    });

    // Close mobile menu on click outside
    document.addEventListener("click", (e) => {
      if (isOpen && !navbar.contains(e.target)) {
        closeMenu();
      }
    });

    // Close mobile menu on link click
    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close mobile menu on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeMenu();
        mobileBtn?.focus();
      }
    });

    // Active link tracking
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav-link");
    const observerOptions = { threshold: 0.3, rootMargin: "-80px 0px -50% 0px" };

    const activeObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active"));
          const activeLink = document.querySelector(
            '.nav-link[href="#' + entry.target.id + '"]'
          );
          if (activeLink) activeLink.classList.add("active");
        }
      });
    }, observerOptions);

    sections.forEach((section) => activeObserver.observe(section));
  })();
</script>
