---
// AnalyticalGridBackground.astro - Vivid Minimalist Organic Starscape & Telemetry Crosshairs
// High-visibility scattered data points & coordinate nodes

const seedRandom = (seed: number) => {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
};

interface Star {
  id: number;
  x: number; // percentage 2% to 98%
  y: number; // percentage 1% to 99%
  radius: number; // 1.2px to 2.6px
  opacity: number; // 0.35 to 0.78
  isCrosshair: boolean;
}

const stars: Star[] = [];
let seed = 142;

// Generate 220 high-visibility organic stars & crosshairs throughout the entire height
for (let i = 0; i < 220; i++) {
  const x = Number((seedRandom(seed++) * 96 + 2).toFixed(2));
  const y = Number((seedRandom(seed++) * 98 + 1).toFixed(2));
  const radius = Number((seedRandom(seed++) * 1.4 + 1.2).toFixed(1));
  const opacity = Number((seedRandom(seed++) * 0.43 + 0.35).toFixed(2));
  const isCrosshair = seedRandom(seed++) > 0.76;

  stars.push({ id: i, x, y, radius, opacity, isCrosshair });
}
---

<div class="analytical-grid-bg absolute inset-0 pointer-events-none select-none overflow-hidden max-w-full z-0 opacity-90 dark:opacity-85" aria-hidden="true">
  <svg class="w-full h-full text-[var(--text)]" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    {
      stars.map((star) => (
        <g style={`opacity: ${star.opacity};`}>
          {star.isCrosshair ? (
            <svg x={`${star.x}%`} y={`${star.y}%`} width="16" height="16" viewBox="-8 -8 16 16" style="overflow: visible;">
              <path
                d="M0 -7V7M-7 0H7"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
              />
              <circle cx="0" cy="0" r="1.6" fill="currentColor" />
            </svg>
          ) : (
            <circle
              cx={`${star.x}%`}
              cy={`${star.y}%`}
              r={star.radius}
              fill="currentColor"
            />
          )}
        </g>
      ))
    }
  </svg>
</div>
