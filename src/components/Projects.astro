---
import { projects } from "../data/projects";
---

<section id="projects" class="py-16 sm:py-20 lg:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-14">
      <p class="reveal text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">
        Featured Work
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Data Analytics Case Studies
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
      <p class="reveal reveal-delay-2 max-w-xl mx-auto text-sm sm:text-base" style="color: var(--text-muted);">
        Real-world business intelligence dashboards demonstrating full analytics lifecycles from data preparation to executive strategic insights.
      </p>
    </div>

    {
      projects.map((project, pIdx) => (
        <div class="reveal reveal-delay-2 card rounded-3xl p-0 overflow-hidden mb-8 sm:mb-12 border shadow-lg" style="border-color: var(--border);">
          <!-- Project Header & Meta -->
          <div class="p-4 sm:p-8 lg:p-10 border-b" style="border-color: var(--border);">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 sm:gap-6">
              <div class="max-w-3xl">
                <span
                  class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full mb-2.5 sm:mb-3 shadow-sm"
                  style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 15%, transparent), color-mix(in srgb, var(--accent-secondary) 10%, transparent)); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);"
                >
                  {project.category}
                </span>
                <h3 class="font-heading text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight mb-3" style="color: var(--text);">
                  {project.title}
                </h3>
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  {project.tools.map((tool) => (
                    <span
                      class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded-full shadow-sm"
                      style="background: color-mix(in srgb, var(--accent-secondary) 8%, var(--bg-surface)); color: var(--accent-secondary); border: 1px solid color-mix(in srgb, var(--accent-secondary) 25%, var(--border));"
                    >
                      {tool}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-col sm:flex-row flex-wrap gap-2.5 sm:gap-3 shrink-0 w-full sm:w-auto">
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary justify-center text-xs sm:text-sm py-2.5 px-4 sm:px-5 shadow-md"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Live Tableau Dashboard
                  </a>
                )}
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary justify-center text-xs sm:text-sm py-2.5 px-4 sm:px-5"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    GitHub Repo
                  </a>
                )}
              </div>
            </div>
          </div>

          <!-- Structured Case Study 4-Pillars -->
          <div class="p-4 sm:p-8 lg:p-10 pb-4 sm:pb-6">
            <div class="grid md:grid-cols-2 gap-3.5 sm:gap-5">
              <!-- Problem -->
              <div
                class="p-4 sm:p-5 rounded-2xl border transition-all duration-300 hover:scale-[1.01] shadow-sm"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 7%, var(--bg-surface)), color-mix(in srgb, var(--accent) 2%, var(--bg-surface))); border-color: color-mix(in srgb, var(--accent) 25%, var(--border));"
              >
                <h4 class="flex items-center gap-2 text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                  1. Business Context & Problem
                </h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.problem}
                </p>
              </div>

              <!-- Process -->
              <div
                class="p-4 sm:p-5 rounded-2xl border transition-all duration-300 hover:scale-[1.01] shadow-sm"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent-secondary) 7%, var(--bg-surface)), color-mix(in srgb, var(--accent-secondary) 2%, var(--bg-surface))); border-color: color-mix(in srgb, var(--accent-secondary) 25%, var(--border));"
              >
                <h4 class="flex items-center gap-2 text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
                  2. Methodology & Process
                </h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.process}
                </p>
              </div>

              <!-- Insight -->
              <div
                class="p-4 sm:p-5 rounded-2xl border transition-all duration-300 hover:scale-[1.01] shadow-sm"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 7%, var(--bg-surface)), color-mix(in srgb, var(--accent) 2%, var(--bg-surface))); border-color: color-mix(in srgb, var(--accent) 25%, var(--border));"
              >
                <h4 class="flex items-center gap-2 text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  3. Key Data Insights Found
                </h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.insight}
                </p>
              </div>

              <!-- Impact -->
              <div
                class="p-4 sm:p-5 rounded-2xl border transition-all duration-300 hover:scale-[1.01] shadow-sm"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent-secondary) 7%, var(--bg-surface)), color-mix(in srgb, var(--accent-secondary) 2%, var(--bg-surface))); border-color: color-mix(in srgb, var(--accent-secondary) 25%, var(--border));"
              >
                <h4 class="flex items-center gap-2 text-xs sm:text-sm font-bold uppercase tracking-wider mb-2" style="color: var(--accent-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v12"/><path d="M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M15 6a9 9 0 0 0-9 9"/></svg>
                  4. Business Impact & Decisions
                </h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.impact}
                </p>
              </div>
            </div>
          </div>

          <!-- Interactive Dashboard Slide Deck (Next/Previous Controls & Animated Viewer) -->
          <div class="p-4 sm:p-8 lg:p-10 pt-0 sm:pt-2">
            <div class="p-3.5 sm:p-6 rounded-2xl border" style="border-color: var(--border); background: color-mix(in srgb, var(--accent) 3%, var(--bg-surface));">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 mb-4">
                <div>
                  <h4 class="font-heading font-bold text-base sm:text-lg" style="color: var(--text);">
                    Interactive Slide Viewer & Dashboard Breakdown
                  </h4>
                  <p class="text-xs sm:text-sm" style="color: var(--text-muted);">
                    Explore each page of the multi-page Tableau dashboard with interactive next / previous navigation.
                  </p>
                </div>

                <!-- Next / Prev Control Buttons -->
                <div class="flex items-center justify-between sm:justify-end gap-2 w-full sm:w-auto shrink-0">
                  <button
                    type="button"
                    class="prev-slide-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold transition-all duration-200 hover:border-sky-500 hover:scale-105 touch-manipulation shadow-sm"
                    style="border-color: var(--border); color: var(--text); background: var(--bg-surface);"
                    data-project={pIdx}
                    aria-label="Previous Slide"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    Previous
                  </button>
                  <span
                    class="slide-counter text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm"
                    style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, transparent), color-mix(in srgb, var(--accent-secondary) 12%, transparent)); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);"
                    id={`slide-counter-${pIdx}`}
                  >
                    1 / {project.slides.length}
                  </span>
                  <button
                    type="button"
                    class="next-slide-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-bold transition-all duration-200 hover:border-sky-500 hover:scale-105 touch-manipulation shadow-sm"
                    style="border-color: var(--border); color: var(--text); background: var(--bg-surface);"
                    data-project={pIdx}
                    aria-label="Next Slide"
                  >
                    Next
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </div>
              </div>

              <!-- Main Slide Screen Display -->
              <div class="relative overflow-hidden rounded-2xl border aspect-[4/3] sm:aspect-[16/10] md:aspect-[16/9] bg-slate-950/60 group shadow-inner" style="border-color: var(--border);">
                {
                  project.slides.map((slide, sIdx) => (
                    <div
                      class={`slide-item absolute inset-0 transition-all duration-500 flex flex-col justify-between ${sIdx === 0 ? "opacity-100 scale-100 z-10 pointer-events-auto" : "opacity-0 scale-95 z-0 pointer-events-none"}`}
                      data-project={pIdx}
                      data-index={sIdx}
                    >
                      <img
                        src={slide.image}
                        alt={`${project.title} - ${slide.title}`}
                        class="w-full h-full object-cover object-top cursor-pointer"
                        loading={sIdx === 0 ? "eager" : "lazy"}
                        onclick={`window.open('${slide.image}', '_blank')`}
                      />
                      <!-- Caption Overlay (High Contrast Solid Glass) -->
                      <div class="absolute bottom-0 inset-x-0 p-3 sm:p-5 border-t border-slate-700/60 bg-slate-950/90 backdrop-blur-md flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3 shadow-2xl">
                        <div class="pr-0 sm:pr-2">
                          <p class="font-heading font-bold text-xs sm:text-base text-sky-400">
                            Slide {sIdx + 1}: <span class="text-white">{slide.title}</span>
                          </p>
                          <p class="text-[11px] sm:text-sm text-slate-200 mt-0.5 sm:mt-1 leading-relaxed line-clamp-2 sm:line-clamp-none">
                            {slide.description}
                          </p>
                        </div>
                        <a
                          href={slide.image}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full text-[11px] sm:text-xs font-extrabold bg-sky-400 hover:bg-sky-300 text-slate-950 transition-all duration-200 shadow-md hover:scale-105"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                          View Full Image
                        </a>
                      </div>
                    </div>
                  ))
                }
              </div>

              <!-- Thumbnail Nav Strip -->
              <div class="grid grid-cols-5 gap-1.5 sm:gap-3 mt-3 sm:mt-4">
                {
                  project.slides.map((slide, sIdx) => (
                    <button
                      type="button"
                      class={`thumb-btn relative overflow-hidden rounded-xl border transition-all duration-300 aspect-[16/10] touch-manipulation ${sIdx === 0 ? "ring-2 ring-sky-400 border-transparent scale-105" : "opacity-60 hover:opacity-100"}`}
                      style="border-color: var(--border);"
                      data-project={pIdx}
                      data-index={sIdx}
                      aria-label={`Jump to slide ${sIdx + 1}`}
                    >
                      <img
                        src={slide.image}
                        alt={`Thumb ${sIdx + 1}`}
                        class="w-full h-full object-cover object-top"
                        loading="lazy"
                      />
                      <span class="absolute bottom-0.5 right-0.5 sm:bottom-1 sm:right-1 px-1 sm:px-1.5 py-0.2 sm:py-0.5 text-[9px] sm:text-[10px] font-bold rounded bg-black/70 text-white">
                        {sIdx + 1}
                      </span>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script is:inline>
  (function () {
    const projectCurrentIndex = {};

    function updateSlide(projectIdx, newIdx) {
      const slides = document.querySelectorAll(`.slide-item[data-project="${projectIdx}"]`);
      const thumbs = document.querySelectorAll(`.thumb-btn[data-project="${projectIdx}"]`);
      const counter = document.getElementById(`slide-counter-${projectIdx}`);
      const total = slides.length;

      if (newIdx < 0) newIdx = total - 1;
      if (newIdx >= total) newIdx = 0;

      projectCurrentIndex[projectIdx] = newIdx;

      slides.forEach((slide, idx) => {
        if (idx === newIdx) {
          slide.classList.remove("opacity-0", "scale-95", "z-0", "pointer-events-none");
          slide.classList.add("opacity-100", "scale-100", "z-10", "pointer-events-auto");
        } else {
          slide.classList.add("opacity-0", "scale-95", "z-0", "pointer-events-none");
          slide.classList.remove("opacity-100", "scale-100", "z-10", "pointer-events-auto");
        }
      });

      thumbs.forEach((thumb, idx) => {
        if (idx === newIdx) {
          thumb.classList.add("ring-2", "ring-sky-400", "border-transparent", "scale-105");
          thumb.classList.remove("opacity-60");
        } else {
          thumb.classList.remove("ring-2", "ring-sky-400", "border-transparent", "scale-105");
          thumb.classList.add("opacity-60");
        }
      });

      if (counter) {
        counter.textContent = `${newIdx + 1} / ${total}`;
      }
    }

    document.querySelectorAll(".prev-slide-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pIdx = parseInt(btn.getAttribute("data-project") || "0", 10);
        const cur = projectCurrentIndex[pIdx] || 0;
        updateSlide(pIdx, cur - 1);
      });
    });

    document.querySelectorAll(".next-slide-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pIdx = parseInt(btn.getAttribute("data-project") || "0", 10);
        const cur = projectCurrentIndex[pIdx] || 0;
        updateSlide(pIdx, cur + 1);
      });
    });

    document.querySelectorAll(".thumb-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pIdx = parseInt(btn.getAttribute("data-project") || "0", 10);
        const sIdx = parseInt(btn.getAttribute("data-index") || "0", 10);
        updateSlide(pIdx, sIdx);
      });
    });
  })();
</script>
