---
import { projects } from "../data/projects";
---

<section id="projects" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="reveal text-sm font-medium uppercase tracking-wider mb-2" style="color: var(--accent);">
        Case Studies
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Projects
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
    </div>

    {
      projects.map((project) => (
        <div class="reveal reveal-delay-2 card p-0 overflow-hidden mb-8">
          <!-- Project Header -->
          <div class="p-6 sm:p-8 pb-0">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
              <div>
                <h3 class="font-heading text-xl sm:text-2xl font-bold mb-2" style="color: var(--text);">
                  {project.title}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {project.tools.map((tool) => (
                    <span
                      class="px-2.5 py-1 text-xs font-medium rounded-md"
                      style="background: color-mix(in srgb, var(--accent-secondary) 15%, transparent); color: var(--accent-secondary); border: 1px solid color-mix(in srgb, var(--accent-secondary) 25%, transparent);"
                    >
                      {tool}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex gap-3 shrink-0">
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-sm py-2 px-4"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Live Dashboard
                  </a>
                )}
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary text-sm py-2 px-4"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    GitHub
                  </a>
                )}
              </div>
            </div>

            <!-- Case Study Grid: Problem → Process → Insight → Impact -->
            <div class="grid sm:grid-cols-2 gap-4 mb-6">
              <div
                class="p-4 rounded-lg"
                style="background: color-mix(in srgb, var(--accent) 5%, var(--bg));"
              >
                <h4 class="flex items-center gap-2 text-sm font-semibold mb-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                  Problem
                </h4>
                <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.problem}
                </p>
              </div>

              <div
                class="p-4 rounded-lg"
                style="background: color-mix(in srgb, var(--accent-secondary) 5%, var(--bg));"
              >
                <h4 class="flex items-center gap-2 text-sm font-semibold mb-2" style="color: var(--accent-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
                  Process
                </h4>
                <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.process}
                </p>
              </div>

              <div
                class="p-4 rounded-lg"
                style="background: color-mix(in srgb, var(--accent) 5%, var(--bg));"
              >
                <h4 class="flex items-center gap-2 text-sm font-semibold mb-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  Insight
                </h4>
                <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.insight}
                </p>
              </div>

              <div
                class="p-4 rounded-lg"
                style="background: color-mix(in srgb, var(--accent-secondary) 5%, var(--bg));"
              >
                <h4 class="flex items-center gap-2 text-sm font-semibold mb-2" style="color: var(--accent-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v12"/><path d="M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M15 6a9 9 0 0 0-9 9"/></svg>
                  Impact
                </h4>
                <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.impact}
                </p>
              </div>
            </div>
          </div>

          <!-- Dashboard Screenshots Gallery -->
          <div class="px-6 sm:px-8 pb-6 sm:pb-8">
            <h4 class="text-sm font-semibold mb-3" style="color: var(--text-muted);">
              Dashboard Preview
            </h4>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
              {project.images.map((img, i) => (
                <a
                  href={img}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/img relative overflow-hidden rounded-lg border transition-all duration-300"
                  style="border-color: var(--border);"
                >
                  <img
                    src={img}
                    alt={`${project.title} - Slide ${i + 1}`}
                    class="w-full h-24 sm:h-28 object-cover object-top transition-transform duration-500 group-hover/img:scale-110"
                    loading="lazy"
                  />
                  <div
                    class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"
                    style="background: rgba(0,0,0,0.5);"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
