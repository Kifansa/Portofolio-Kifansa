---
import { projects } from "../data/projects";
---

<section id="projects" class="py-16 sm:py-20 lg:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-12 sm:mb-16">
      <div class="reveal-left">
        <p class="section-eyebrow">Portfolio Work</p>
        <h2 class="section-heading" style="color: var(--text);">
          Featured Projects
        </h2>
        <div class="section-line"></div>
      </div>
      <p class="reveal-right max-w-md text-sm sm:text-base lg:text-right lg:pb-2" style="color: var(--text-muted);">
        Enterprise Business Intelligence, Big Data Machine Learning pipelines, and Cloud Data Warehousing engineered for executive decision-making.
      </p>
    </div>

    <!-- Projects List: Minimalist & Clean on Main Page -->
    <div class="space-y-10 sm:space-y-14">
      {
        projects.map((project, pIdx) => (
          <div
            id={project.id}
            class="reveal reveal-delay-2 card rounded-3xl p-6 sm:p-8 lg:p-10 border transition-all duration-300 relative scroll-mt-24"
            style="border-color: color-mix(in srgb, var(--border) 60%, transparent);"
          >
            <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-center">
              <!-- Left: Dashboard Visual Preview -->
              <div class="lg:col-span-6">
                <div class="relative rounded-2xl overflow-hidden border shadow-sm cursor-pointer open-project-details-btn transition-transform duration-300 hover:scale-[1.01]" data-project-idx={pIdx} style="background: var(--bg-surface); border-color: var(--border);">
                  <img
                    src={project.slides[0].image}
                    alt={project.title}
                    class="w-full aspect-[16/10] object-cover object-top block"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Right: Project Title, Concise Summary, & Action Buttons -->
              <div class="lg:col-span-6 flex flex-col justify-center space-y-4">
                <h3 class="font-heading text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight" style="color: var(--text);">
                  {project.title}
                </h3>

                <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-muted);">
                  {project.summary}
                </p>

                <!-- Action Button Row -->
                <div class="flex flex-wrap items-center gap-3 pt-2">
                  <button
                    type="button"
                    class="open-project-details-btn btn-primary text-xs sm:text-sm py-2.5 px-5 shadow-sm cursor-pointer flex items-center gap-2"
                    data-project-idx={pIdx}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    Project Details
                  </button>

                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary text-xs sm:text-sm py-2.5 px-4"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      Live Tableau
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Dedicated Project Details Modal (Contains KPIs, Detailed Narrative Dossier & Tags) -->
  {
    projects.map((project, pIdx) => (
      <div
        id={`project-details-modal-${pIdx}`}
        role="dialog"
        aria-modal="true"
        aria-labelledby={`modal-title-${pIdx}`}
        class="project-details-modal fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 lg:p-8 transition-opacity duration-300"
      >
        <div
          class="relative max-w-5xl w-full rounded-3xl border overflow-hidden flex flex-col max-h-[92vh] shadow-2xl animate-in fade-in zoom-in-95 duration-200"
          style="background: var(--bg-card); border-color: var(--border);"
        >
          <!-- Modal Header -->
          <div class="flex items-start justify-between p-5 sm:p-6 border-b shrink-0" style="border-color: var(--border);">
            <div class="space-y-1 pr-4">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span
                  class="inline-flex items-center px-3 py-0.5 text-xs font-bold uppercase tracking-wider rounded-full"
                  style="color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));"
                >
                  {project.badge}
                </span>
                {project.teamBadge && (
                  <span
                    class="inline-flex items-center gap-1 px-3 py-0.5 text-xs font-semibold rounded-full"
                    style="color: var(--accent-tertiary); background: color-mix(in srgb, var(--accent-tertiary) 8%, var(--bg-card)); border: 1px solid color-mix(in srgb, var(--accent-tertiary) 20%, var(--border));"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    {project.teamBadge}
                  </span>
                )}
              </div>
              <h3 id={`modal-title-${pIdx}`} class="font-heading text-lg sm:text-2xl font-bold tracking-tight" style="color: var(--text);">
                {project.title}
              </h3>
            </div>
            <button
              type="button"
              class="close-modal-btn p-2 rounded-xl border hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shrink-0"
              style="border-color: var(--border); color: var(--text);"
              aria-label="Close project details"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <!-- Modal Scrollable Content -->
          <div class="p-5 sm:p-7 overflow-y-auto space-y-6 flex-1">
            <!-- Key Metrics / KPI Strip inside Details -->
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider mb-3" style="color: var(--text-muted);">
                Executive Key Performance Metrics
              </h4>
              <div class="grid grid-cols-3 gap-3 sm:gap-4">
                {project.metrics.map((metric) => (
                  <div class="kpi-card p-3 sm:p-4 text-center rounded-2xl border" style="background: var(--bg-surface); border-color: var(--border);">
                    <span class="text-lg sm:text-2xl font-extrabold font-heading block" style="color: var(--accent);">
                      {metric.value}
                    </span>
                    <span class="text-[11px] sm:text-xs font-semibold block leading-tight mt-0.5" style="color: var(--text);">
                      {metric.label}
                    </span>
                    <span class="text-[10px] block leading-tight mt-0.5 hidden sm:block" style="color: var(--text-muted);">
                      {metric.desc}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Visual Showcase with Click-to-Zoom & Multi-Slide Support -->
            <div class="space-y-3">
              <div class="rounded-2xl overflow-hidden border shadow-sm relative group" style="background: var(--bg-surface); border-color: var(--border);">
                <img
                  id={`modal-slide-img-${pIdx}`}
                  src={project.slides[0].image}
                  alt={project.slides[0].title}
                  class="w-full aspect-[16/10] object-cover object-top cursor-pointer transition-transform duration-300 group-hover:scale-[1.01]"
                  loading="lazy"
                />
                <!-- Click to Zoom Trigger Overlay -->
                <button
                  type="button"
                  class="trigger-lightbox-btn absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center gap-2 text-white text-xs sm:text-sm font-bold backdrop-blur-[2px] cursor-pointer"
                  data-img-src={project.slides[0].image}
                  data-img-title={`${project.title} — ${project.slides[0].title}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  Click to View Full-Size Dashboard
                </button>

                <div class="py-2 px-4 border-t flex items-center justify-between text-xs font-medium" style="background: var(--bg-card); border-color: var(--border); color: var(--text);">
                  <span id={`modal-slide-title-${pIdx}`} class="font-bold truncate max-w-[70%]">
                    {project.slides[0].title}
                  </span>
                  <span class="text-[11px]" style="color: var(--text-muted);">
                    Slide <span id={`modal-slide-num-${pIdx}`}>1</span> of {project.slides.length}
                  </span>
                </div>
              </div>

              <!-- Thumbnails if multi-slide -->
              {project.slides.length > 1 && (
                <div class="flex items-center gap-2 overflow-x-auto pb-1">
                  {project.slides.map((slide, sIdx) => (
                    <button
                      type="button"
                      class={`modal-thumb-btn flex-1 min-w-[75px] p-1 rounded-xl border text-left transition-all duration-200 cursor-pointer ${
                        sIdx === 0 ? "border-sky-500 ring-2 ring-sky-500/20" : "opacity-70 hover:opacity-100"
                      }`}
                      style="background: var(--bg-card); border-color: var(--border);"
                      data-project-idx={pIdx}
                      data-slide-idx={sIdx}
                      data-img={slide.image}
                      data-title={slide.title}
                    >
                      <img src={slide.image} alt={slide.title} class="w-full aspect-[16/10] object-cover rounded-lg mb-1" loading="lazy" />
                      <span class="block text-[10px] font-bold truncate leading-tight" style="color: var(--text);">
                        {slide.title}
                      </span>
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Structured 3-Pillar Narrative Dossier -->
            <div class="grid md:grid-cols-3 gap-4">
              <!-- 1. Objective & Scope -->
              <div class="p-4 rounded-2xl border" style="background: var(--bg-surface); border-color: var(--border);">
                <h5 class="text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                  Business Problem
                </h5>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.problem}
                </p>
              </div>

              <!-- 2. Technical Pipeline -->
              <div class="p-4 rounded-2xl border" style="background: var(--bg-surface); border-color: var(--border);">
                <h5 class="text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2" style="color: var(--accent-secondary);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  Technical Pipeline
                </h5>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.architecture}
                </p>
              </div>

              <!-- 3. Key Findings & Impact -->
              <div class="p-4 rounded-2xl border" style="background: var(--bg-surface); border-color: var(--border);">
                <h5 class="text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2" style="color: var(--accent);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  Insights &amp; Impact
                </h5>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
                  {project.impact}
                </p>
              </div>
            </div>

            <!-- Tool & Technology Tags inside Details -->
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider mb-2.5" style="color: var(--text-muted);">
                Technology &amp; Analytical Frameworks
              </h4>
              <div class="flex flex-wrap gap-2">
                {project.tools.map((tool) => (
                  <span class="badge-slate text-xs py-1 px-3">
                    {tool}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Modal Footer with External Links -->
          <div class="p-4 sm:p-5 border-t flex flex-wrap items-center justify-between gap-3 shrink-0" style="background: var(--bg-surface); border-color: var(--border);">
            <div class="flex flex-wrap items-center gap-2.5">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary text-xs sm:text-sm py-2 px-4 shadow-sm"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Open Live Tableau
                </a>
              )}
            </div>
            <button
              type="button"
              class="close-modal-btn btn-secondary text-xs sm:text-sm py-2 px-4 cursor-pointer"
            >
              Close Details
            </button>
          </div>
        </div>
      </div>
    ))
  }

  <!-- Full-Screen High-Resolution Lightbox Image Viewer (Top Level z-[60]) -->
  <div
    id="dashboard-lightbox-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
    class="fixed inset-0 z-[60] bg-slate-950/90 backdrop-blur-md hidden items-center justify-center p-3 sm:p-6 transition-opacity duration-300"
  >
    <div
      class="relative max-w-6xl w-full rounded-3xl border overflow-hidden flex flex-col max-h-[95vh] shadow-2xl animate-in fade-in zoom-in-95 duration-200"
      style="background: var(--bg-card); border-color: var(--border);"
    >
      <!-- Lightbox Header with Title and Red Close Button -->
      <div class="flex items-center justify-between px-5 sm:px-6 py-3.5 border-b shrink-0" style="border-color: var(--border);">
        <h4 id="lightbox-title" class="font-heading font-bold text-sm sm:text-base truncate pr-4" style="color: var(--text);">
          Dashboard Inspection View
        </h4>

        <button
          id="close-lightbox-btn"
          type="button"
          class="p-2 rounded-xl border border-red-500/30 bg-red-500/10 text-red-500 dark:text-red-400 hover:bg-red-500/20 hover:border-red-500/50 transition-colors cursor-pointer shadow-sm hover:scale-[1.05]"
          aria-label="Close image inspection"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Main Image Display -->
      <div class="p-3 sm:p-6 overflow-y-auto flex-1 flex items-center justify-center bg-slate-950/20">
        <img
          id="lightbox-img"
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
          alt="Full Resolution Dashboard"
          class="max-w-full max-h-[82vh] object-contain rounded-xl shadow-lg"
        />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // 1. Open & Close Project Details Modal
    const openBtns = document.querySelectorAll(".open-project-details-btn");
    let activeDetailsModal = null;
    let lastActiveTrigger = null;

    function lockScroll() {
      document.body.style.overflow = "hidden";
      document.documentElement.style.overflow = "hidden";
    }

    function unlockScroll() {
      // Only unlock if neither details modal nor lightbox is active
      if (!activeDetailsModal && (!lightboxModal || lightboxModal.classList.contains("hidden"))) {
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";
      }
    }

    function openModalWithTransition(modal) {
      const doOpen = () => {
        activeDetailsModal = modal;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        lockScroll();
        const closeBtn = modal.querySelector(".close-modal-btn");
        closeBtn?.focus();
      };

      if (document.startViewTransition && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.startViewTransition(() => {
          doOpen();
        });
      } else {
        doOpen();
      }
    }

    openBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        lastActiveTrigger = btn;
        const pIdx = btn.getAttribute("data-project-idx");
        const modal = document.getElementById(`project-details-modal-${pIdx}`);

        if (modal) {
          openModalWithTransition(modal);
        }
      });
    });

    function closeDetailsModal() {
      if (!activeDetailsModal) return;
      const modal = activeDetailsModal;

      const doClose = () => {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
        activeDetailsModal = null;
        unlockScroll();

        if (lastActiveTrigger && typeof lastActiveTrigger.focus === "function") {
          lastActiveTrigger.focus();
        }
      };

      if (document.startViewTransition && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.startViewTransition(() => {
          doClose();
        });
      } else {
        doClose();
      }
    }

    const closeDetailsBtns = document.querySelectorAll(".close-modal-btn");
    closeDetailsBtns.forEach((btn) => {
      btn.addEventListener("click", closeDetailsModal);
    });

    const detailsModals = document.querySelectorAll(".project-details-modal");
    detailsModals.forEach((modal) => {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeDetailsModal();
      });
    });

    // 2. High-Resolution Lightbox Modal Logic
    const lightboxModal = document.getElementById("dashboard-lightbox-modal");
    const closeLightboxBtn = document.getElementById("close-lightbox-btn");
    const lightboxImg = document.getElementById("lightbox-img");
    const lightboxTitle = document.getElementById("lightbox-title");
    const lightboxTriggers = document.querySelectorAll(".trigger-lightbox-btn");
    let lastLightboxTrigger = null;

    lightboxTriggers.forEach((trig) => {
      trig.addEventListener("click", (e) => {
        e.stopPropagation();
        lastLightboxTrigger = trig;
        const src = trig.getAttribute("data-img-src");
        const title = trig.getAttribute("data-img-title");

        if (lightboxImg && src) lightboxImg.src = src;
        if (lightboxTitle && title) lightboxTitle.textContent = title;

        if (lightboxModal) {
          lightboxModal.classList.remove("hidden");
          lightboxModal.classList.add("flex");
          lockScroll();
          closeLightboxBtn?.focus();
        }
      });
    });

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.remove("flex");
      lightboxModal.classList.add("hidden");
      unlockScroll();

      if (lastLightboxTrigger && typeof lastLightboxTrigger.focus === "function") {
        lastLightboxTrigger.focus();
      }
    }

    closeLightboxBtn?.addEventListener("click", closeLightbox);

    lightboxModal?.addEventListener("click", (e) => {
      if (e.target === lightboxModal) closeLightbox();
    });

    // 3. Global Escape key handling
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (lightboxModal && !lightboxModal.classList.contains("hidden")) {
          closeLightbox();
        } else if (activeDetailsModal) {
          closeDetailsModal();
        }
      }
    });

    // 4. Multi-Slide Thumbnail Switcher within Modals
    const thumbBtns = document.querySelectorAll(".modal-thumb-btn");
    thumbBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const pIdx = btn.getAttribute("data-project-idx");
        const sIdx = btn.getAttribute("data-slide-idx");
        const img = btn.getAttribute("data-img");
        const title = btn.getAttribute("data-title");

        const mainImg = document.getElementById(`modal-slide-img-${pIdx}`);
        const titleEl = document.getElementById(`modal-slide-title-${pIdx}`);
        const numEl = document.getElementById(`modal-slide-num-${pIdx}`);
        const trigger = mainImg?.parentElement?.querySelector(".trigger-lightbox-btn");

        if (mainImg) mainImg.src = img;
        if (titleEl) titleEl.textContent = title;
        if (numEl) numEl.textContent = (parseInt(sIdx) + 1).toString();
        if (trigger) {
          trigger.setAttribute("data-img-src", img);
          trigger.setAttribute("data-img-title", title);
        }

        // Active thumb styling
        const siblingThumbs = btn.parentElement?.querySelectorAll(".modal-thumb-btn");
        siblingThumbs?.forEach((t) => {
          t.classList.remove("border-sky-500", "ring-2", "ring-sky-500/20");
          t.classList.add("opacity-70");
        });
        btn.classList.add("border-sky-500", "ring-2", "ring-sky-500/20");
        btn.classList.remove("opacity-70");
      });
    });
  })();
</script>
