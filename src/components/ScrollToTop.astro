---
// ScrollToTop.astro - Floating popup button to smoothly scroll to the top of the page
---

<button
  id="scroll-to-top"
  type="button"
  aria-label="Scroll to top"
  title="Scroll to top"
  class="fixed bottom-6 right-6 z-40 p-0 w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center cursor-pointer shadow-lg transition-all duration-300 opacity-0 pointer-events-none translate-y-5 scale-90 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border)] touch-manipulation"
  style="background: var(--bg-card); border: 1px solid var(--border); box-shadow: var(--shadow-lg);"
>
  <!-- Circular SVG Progress Ring -->
  <svg
    class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none p-[2px]"
    viewBox="0 0 44 44"
  >
    <!-- Background track -->
    <circle
      cx="22"
      cy="22"
      r="19"
      stroke="currentColor"
      stroke-width="2.5"
      fill="none"
      class="opacity-15 dark:opacity-25"
      style="color: var(--text-muted);"
    />
    <!-- Progress bar -->
    <circle
      id="scroll-progress-indicator"
      cx="22"
      cy="22"
      r="19"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="none"
      stroke-dasharray="119.38"
      stroke-dashoffset="119.38"
      class="transition-[stroke-dashoffset] duration-75"
      style="color: var(--accent);"
    />
  </svg>

  <!-- Up Arrow Icon -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-5 h-5 transition-transform duration-200 group-hover:-translate-y-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    style="color: var(--accent);"
  >
    <path d="m18 15-6-6-6 6"></path>
  </svg>
</button>

<style>
  #scroll-to-top.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  #scroll-to-top:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  #scroll-to-top:active {
    transform: translateY(-1px) scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-to-top {
      transition: opacity 0.2s ease !important;
      transform: none !important;
    }
    #scroll-to-top.show {
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    function initScrollToTop() {
      const scrollBtn = document.getElementById("scroll-to-top");
      const progressCircle = document.getElementById("scroll-progress-indicator");
      if (!scrollBtn || !progressCircle) return;

      const circumference = 2 * Math.PI * 19; // ~119.38
      let ticking = false;

      function updateScroll() {
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;

        // Toggle button popup visibility after scrolling down 250px
        if (scrollY > 250) {
          scrollBtn.classList.add("show");
        } else {
          scrollBtn.classList.remove("show");
        }

        // Calculate and update progress ring
        if (scrollHeight > 0) {
          const progress = Math.min(Math.max(scrollY / scrollHeight, 0), 1);
          const offset = circumference - progress * circumference;
          progressCircle.style.strokeDashoffset = offset.toString();
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(updateScroll);
          ticking = true;
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });

      scrollBtn.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });

      updateScroll();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initScrollToTop);
    } else {
      initScrollToTop();
    }
    document.addEventListener("astro:page-load", initScrollToTop);
  })();
</script>
