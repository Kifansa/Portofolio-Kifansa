---
// Education.astro - Education & Academic Background Section (Borderless Modern Minimalist)
---

<section id="education" class="py-16 sm:py-20 lg:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-10 sm:mb-14">
      <div class="reveal-left">
        <p class="section-eyebrow">Academic Background</p>
        <h2 class="section-heading" style="color: var(--text);">
          Education
        </h2>
        <div class="section-line"></div>
      </div>
      <p class="reveal-right max-w-md text-sm sm:text-base lg:text-right lg:pb-2 leading-relaxed" style="color: var(--text-muted);">
        Formal academic background, relevant analytical coursework, and cumulative performance.
      </p>
    </div>

    <!-- Main Education: Borderless Clean Presentation -->
    <div class="reveal reveal-delay-2 transition-all duration-300 relative">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Logo & Core Degree Information -->
        <div class="lg:col-span-8 flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7">
          <!-- University Logo Container with Clean Border -->
          <div class="shrink-0 w-22 h-22 sm:w-24 sm:h-24 rounded-2xl bg-white p-3 flex items-center justify-center border shadow-xs transition-transform duration-300 hover:scale-105" style="border-color: var(--border);">
            <img
              src="/images/Telkom_university_surabaya.webp"
              alt="Telkom University Surabaya Logo"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>

          <!-- University & Major Info -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-medium px-3 py-1 rounded-full border" style="color: var(--text-muted); border-color: var(--border); background: var(--bg-surface);">
                Sep 2023 – Present
              </span>
            </div>

            <h3 class="font-heading font-bold text-2xl sm:text-3xl tracking-tight" style="color: var(--text);">
              Telkom University Surabaya
            </h3>

            <p class="text-base sm:text-lg font-semibold" style="color: var(--text);">
              Bachelor of Information Systems
            </p>

            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
              Faculty of Industrial Engineering · Surabaya, East Java, Indonesia
            </p>
          </div>
        </div>

        <!-- Right: GPA Highlight Metric (Centered with Gray Gradient & Line Accent) -->
        <div class="lg:col-span-4 flex flex-col justify-center">
          <div
            class="kpi-card text-center p-5 sm:p-7 rounded-2xl flex flex-col items-center justify-center group"
            style="background: var(--bg-card); border: 1px solid var(--border); box-shadow: var(--shadow); backdrop-filter: blur(24px) saturate(190%); -webkit-backdrop-filter: blur(24px) saturate(190%);"
          >
            <div class="relative z-10">
              <span class="text-xs font-bold uppercase tracking-wider block mb-1.5" style="color: var(--text-muted);">
                Cumulative GPA
              </span>
              <div class="flex items-baseline justify-center gap-1.5">
                <span class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading" style="color: var(--text);" data-count-to="3.86" data-decimals="2">
                  3.86
                </span>
                <span class="text-sm sm:text-base font-bold" style="color: var(--text-muted);">
                  / 4.00
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Subtle Divider -->
      <div class="my-8 sm:my-10 border-t" style="border-color: var(--border);"></div>

      <!-- Additional Academic Focus & Highlights -->
      <div class="grid md:grid-cols-2 gap-8 sm:gap-12">
        <!-- Focus Area -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider mb-3.5 flex items-center gap-2" style="color: var(--text);">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            Focus &amp; Relevant Coursework
          </h4>
          <div class="flex flex-wrap gap-2">
            {
              [
                "Data Analytics",
                "Data Mining",
                "Machine Learning",
                "Database Systems & SQL",
                "Business Intelligence",
                "Enterprise Systems & ERP",
                "Statistics & Probability",
                "Object-Oriented Programming"
              ].map((item) => (
                <span
                  class="px-3 py-1.5 text-xs font-medium rounded-full border"
                  style="color: var(--text); background: var(--bg-surface); border-color: var(--border);"
                >
                  {item}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Academic Role & Activities -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider mb-3.5 flex items-center gap-2" style="color: var(--text);">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            Academic Roles &amp; Activities
          </h4>
          <ul class="space-y-2.5 text-xs sm:text-sm leading-relaxed" style="color: var(--text-muted);">
            <li class="flex items-start gap-2.5">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full" style="background: var(--text);"></span>
              <span>Teaching Assistant for <strong style="color: var(--text);">Data Mining</strong> and <strong style="color: var(--text);">Object-Oriented Programming (OOP)</strong> lab sessions.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full" style="background: var(--text);"></span>
              <span>Contributed to community research on digital transformation and IT literacy for local enterprise initiatives.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
