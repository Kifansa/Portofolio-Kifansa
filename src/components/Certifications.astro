---
import { certifications } from "../data/certifications";
---

<section id="certifications" class="py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="reveal text-sm font-medium uppercase tracking-wider mb-2" style="color: var(--accent);">
        Verified Credentials
      </p>
      <h2 class="reveal reveal-delay-1 section-heading" style="color: var(--text);">
        Certifications
      </h2>
      <div class="reveal reveal-delay-1 section-line mx-auto"></div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        certifications.map((cert, idx) => (
          <div class={`reveal reveal-delay-${Math.min(idx + 1, 5)} card group overflow-hidden`}>
            {cert.image ? (
              <div class="relative -mx-6 -mt-6 mb-4 overflow-hidden">
                <img
                  src={cert.image}
                  alt={`${cert.name} certificate`}
                  class="w-full h-44 object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                {cert.courses && (
                  <span
                    class="absolute top-3 right-3 px-2.5 py-1 text-xs font-semibold rounded-md"
                    style="background: var(--accent); color: #0B0F19;"
                  >
                    {cert.courses} Courses
                  </span>
                )}
              </div>
            ) : (
              <div
                class="relative -mx-6 -mt-6 mb-4 h-44 flex items-center justify-center"
                style="background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 15%, transparent), color-mix(in srgb, var(--accent-secondary) 15%, transparent));"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); opacity: 0.5;">
                  <circle cx="12" cy="8" r="6" /><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                </svg>
              </div>
            )}

            <h3 class="font-heading font-semibold text-base mb-1" style="color: var(--text);">
              {cert.name}
            </h3>
            <p class="text-sm mb-3" style="color: var(--text-muted);">
              {cert.issuer} · {cert.date}
            </p>

            {cert.verifyUrl && (
              <a
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-medium transition-colors duration-200"
                style="color: var(--accent);"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Verify Certificate
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
