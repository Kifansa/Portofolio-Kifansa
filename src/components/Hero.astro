---
import DataAnalystBackground from "./DataAnalystBackground.astro";
---

<section id="hero" class="relative min-h-[95vh] flex items-center justify-center overflow-hidden pt-24 pb-16">
  <!-- Interactive Data Analyst Background (Dots & Constellation Mesh) -->
  <DataAnalystBackground />

  <!-- Animated gradient orbs (decorative) -->
  <div class="absolute top-1/4 -left-32 w-80 h-80 rounded-full opacity-20 blur-3xl animate-pulse-glow pointer-events-none" style="background: var(--accent);"></div>
  <div class="absolute bottom-1/4 -right-32 w-80 h-80 rounded-full opacity-15 blur-3xl animate-pulse-glow pointer-events-none" style="background: var(--accent-secondary); animation-delay: 2.5s;"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Name -->
    <h1 class="reveal reveal-delay-1 font-heading text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight mb-4" style="color: var(--text);">
      Kifansa Naufal
      <span class="gradient-text block sm:inline"> Fadhlurrohman</span>
    </h1>

    <!-- Headline -->
    <p class="reveal reveal-delay-2 text-lg sm:text-xl md:text-2xl font-semibold mb-5 tracking-tight" style="color: var(--accent);">
      Data Analyst · Turning Raw Data into Strategic Business Decisions
    </p>

    <!-- Sub-headline -->
    <p class="reveal reveal-delay-3 max-w-2xl mx-auto text-base sm:text-lg mb-8 leading-relaxed font-normal" style="color: var(--text-muted);">
      Information Systems student at Telkom University Surabaya with deep expertise in exploratory data analysis, predictive modeling, and executive BI dashboards. Certified by Google in Advanced Data Analytics & AI.
    </p>

    <!-- CTA Buttons -->
    <div class="reveal reveal-delay-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-12">
      <a
        href="https://www.linkedin.com/in/kifansanaufal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        Connect on LinkedIn
      </a>
      <a href="#projects" class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        View Projects
      </a>
      <a href="#contact" class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        Contact Me
      </a>
    </div>

    <!-- Quick Metrics Grid -->
    <div class="reveal reveal-delay-5 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
      <div class="card p-4 rounded-2xl flex flex-col items-center justify-center border text-center transition-all duration-300 hover:scale-105">
        <span class="text-2xl sm:text-3xl font-extrabold font-heading gradient-text">3.86 / 4.00</span>
        <span class="text-xs font-semibold mt-1" style="color: var(--text-muted);">Current Cumulative GPA</span>
      </div>
      <div class="card p-4 rounded-2xl flex flex-col items-center justify-center border text-center transition-all duration-300 hover:scale-105">
        <span class="text-2xl sm:text-3xl font-extrabold font-heading gradient-text">3x Google</span>
        <span class="text-xs font-semibold mt-1" style="color: var(--text-muted);">Professional Data & AI Certifications</span>
      </div>
      <div class="card p-4 rounded-2xl flex flex-col items-center justify-center border text-center transition-all duration-300 hover:scale-105">
        <span class="text-2xl sm:text-3xl font-extrabold font-heading gradient-text">100K+ Rows</span>
        <span class="text-xs font-semibold mt-1" style="color: var(--text-muted);">Data Processed & Modeled</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 reveal reveal-delay-6">
    <a href="#about" class="flex flex-col items-center gap-1.5 text-xs font-medium animate-bounce" style="color: var(--text-muted);" aria-label="Scroll to About section">
      <span>Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </div>
</section>
