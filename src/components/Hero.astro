---
import { Linkedin, ArrowDown } from "lucide-react";
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Subtle background grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--accent) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <!-- Gradient orbs (decorative) -->
  <div class="absolute top-1/4 -left-32 w-64 h-64 rounded-full opacity-20 blur-3xl" style="background: var(--accent);"></div>
  <div class="absolute bottom-1/4 -right-32 w-64 h-64 rounded-full opacity-15 blur-3xl" style="background: var(--accent-secondary);"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Greeting badge -->
    <div class="reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6 border" style="border-color: var(--border); color: var(--text-muted); background: var(--bg-surface);">
      <span class="w-2 h-2 rounded-full animate-pulse" style="background: var(--accent);"></span>
      Open to opportunities
    </div>

    <!-- Name -->
    <h1 class="reveal reveal-delay-1 font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-4" style="color: var(--text);">
      Kifansa Naufal
      <span class="gradient-text block sm:inline"> Fadhlurrohman</span>
    </h1>

    <!-- Headline -->
    <p class="reveal reveal-delay-2 text-lg sm:text-xl md:text-2xl font-medium mb-4" style="color: var(--accent);">
      Data Analyst · Turning Raw Data into Business Decisions
    </p>

    <!-- Sub-headline -->
    <p class="reveal reveal-delay-3 max-w-2xl mx-auto text-base sm:text-lg mb-8 leading-relaxed" style="color: var(--text-muted);">
      Information Systems student with a passion for data analytics and machine learning.
      Certified by Google in Data Analysis & AI, experienced in delivering end-to-end
      data insights that drive strategic business outcomes.
    </p>

    <!-- CTA Buttons -->
    <div class="reveal reveal-delay-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://www.linkedin.com/in/kifansanaufal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        Connect on LinkedIn
      </a>
      <a href="#projects" class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        View Projects
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 reveal reveal-delay-5">
    <a href="#about" class="flex flex-col items-center gap-2 text-xs font-medium animate-bounce" style="color: var(--text-muted);">
      <span>Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </div>
</section>
