---
import DataAnalystBackground from "./DataAnalystBackground.astro";
---

<section id="hero" class="relative min-h-[90vh] sm:min-h-[95vh] flex items-center overflow-hidden pt-28 pb-14 sm:pt-32 sm:pb-16">
  <!-- Interactive Analytical Cartesian Grid Background -->
  <DataAnalystBackground />

  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left: Identity & CTA -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <h1 class="reveal reveal-delay-1 font-heading text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-extrabold tracking-tight mb-3 sm:mb-4" style="color: var(--text);">
          Kifansa Naufal
          <span class="block sm:inline" style="color: var(--accent);"> Fadhlurrohman</span>
        </h1>

        <!-- Headline -->
        <p class="reveal reveal-delay-2 text-base sm:text-xl md:text-2xl font-bold mb-4 sm:mb-5 tracking-tight" style="color: var(--text);">
          Data Analyst · <span style="color: var(--accent);">Bridging Strategic BI &amp; Predictive Data Science</span>
        </p>

        <!-- Sub-headline -->
        <p class="reveal reveal-delay-3 max-w-2xl mx-auto lg:mx-0 text-sm sm:text-base md:text-lg mb-7 sm:mb-9 leading-relaxed font-normal" style="color: var(--text-muted);">
          Analytics specialist skilled in exploratory data modeling, predictive machine learning pipelines, and executive BI dashboards. 3x Google Certified in Data Analytics and Applied AI, translating messy operational datasets into measurable business growth.
        </p>

        <!-- CTA Buttons (Aligned in a Clean Horizontal Row) -->
        <div class="reveal reveal-delay-4 flex flex-wrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3.5 mb-8 sm:mb-10 w-full">
          <a
            href="https://www.linkedin.com/in/kifansanaufal"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary justify-center text-xs sm:text-sm py-2.5 sm:py-3 px-4 sm:px-5.5 shadow-md"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            Connect on LinkedIn
          </a>
          <a href="#projects" class="btn-secondary justify-center text-xs sm:text-sm py-2.5 sm:py-3 px-4 sm:px-5.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            Explore Projects
          </a>
          <a href="#contact" class="btn-secondary justify-center text-xs sm:text-sm py-2.5 sm:py-3 px-4 sm:px-5.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Contact
          </a>
        </div>

        <!-- Quick Metrics Grid (Crisp Solid Numerals with Live Telemetry Count-up) -->
        <div class="reveal reveal-delay-5 grid grid-cols-3 gap-3 sm:gap-4 max-w-xl mx-auto lg:mx-0">
          <div class="kpi-card text-center">
            <span class="block text-lg sm:text-2xl font-extrabold font-heading leading-tight" style="color: var(--accent);"><span data-count-to="3.86" data-decimals="2">3.86</span><span class="text-xs sm:text-sm font-bold" style="color: var(--text-muted);"> / 4.00</span></span>
            <span class="text-[10px] sm:text-xs font-semibold mt-1 block leading-tight" style="color: var(--text);">Cumulative GPA</span>
            <span class="text-[9px] sm:text-[10px] block leading-tight mt-0.5" style="color: var(--text-muted);">Telkom University</span>
          </div>
          <div class="kpi-card text-center">
            <span class="block text-lg sm:text-2xl font-extrabold font-heading leading-tight" style="color: var(--accent);"><span data-count-to="3" data-suffix="x Google">3x Google</span></span>
            <span class="text-[10px] sm:text-xs font-semibold mt-1 block leading-tight" style="color: var(--text);">Professional Certs</span>
            <span class="text-[9px] sm:text-[10px] block leading-tight mt-0.5" style="color: var(--text-muted);">Data Analytics &amp; AI</span>
          </div>
          <div class="kpi-card text-center">
            <span class="block text-lg sm:text-2xl font-extrabold font-heading leading-tight" style="color: var(--accent);"><span data-count-to="100" data-suffix="K+">100K+</span></span>
            <span class="text-[10px] sm:text-xs font-semibold mt-1 block leading-tight" style="color: var(--text);">Records Modeled</span>
            <span class="text-[9px] sm:text-[10px] block leading-tight mt-0.5" style="color: var(--text-muted);">Multi-source ETL &amp; BI</span>
          </div>
        </div>
      </div>

      <!-- Right: Professional Photo Card -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end reveal-scale reveal-delay-3">
        <div class="relative group max-w-[320px] sm:max-w-[360px] w-full">
          <div class="profile-frame relative transition-transform duration-300 group-hover:scale-[1.01]">
            <img
              src="/images/profile.webp"
              alt="Kifansa Naufal Fadhlurrohman — Data Analyst"
              class="w-full aspect-[4/5] object-cover object-top rounded-[1rem]"
              loading="eager"
            />
            <!-- Info bar -->
            <div class="absolute bottom-3 left-3 right-3 py-2 px-3 rounded-xl border flex items-center justify-between text-xs font-semibold shadow-md" style="background: var(--bg-card); border-color: var(--border);">
              <span class="font-medium" style="color: var(--text);">Telkom University</span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-bold shadow-sm text-white text-[11px]" style="background: var(--btn-primary-bg);">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                Surabaya, ID
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator (Smooth, no tacky bounce) -->
  <div class="hidden sm:block absolute bottom-4 left-1/2 -translate-x-1/2 reveal reveal-delay-6 z-10">
    <a href="#about" class="flex flex-col items-center gap-1 text-xs font-semibold transition-colors duration-200 hover:text-sky-500" style="color: var(--text-muted);" aria-label="Scroll to About section">
      <span>Scroll Down</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </div>
</section>
