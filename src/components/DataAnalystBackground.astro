---
// DataAnalystBackground.astro - Executive Analytical Coordinate Plane & Telemetry Grid
---

<div id="data-analyst-bg-container" class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
  <canvas id="analytical-canvas" class="w-full h-full block opacity-75 dark:opacity-60 transition-opacity duration-500"></canvas>
</div>

<script is:inline>
  (function () {
    const container = document.getElementById("data-analyst-bg-container");
    const canvas = document.getElementById("analytical-canvas");
    if (!container || !canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animationFrameId = null;
    let isVisible = true;

    // Mouse coordinates (relative to container)
    let mouse = { x: -1000, y: -1000, targetX: -1000, targetY: -1000, active: false };

    function resize() {
      const rect = container.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    function onMouseMove(e) {
      const rect = container.getBoundingClientRect();
      mouse.targetX = e.clientX - rect.left;
      mouse.targetY = e.clientY - rect.top;
      mouse.active = true;
    }

    function onMouseLeave() {
      mouse.active = false;
      mouse.targetX = -1000;
      mouse.targetY = -1000;
    }

    window.addEventListener("mousemove", onMouseMove, { passive: true });
    document.addEventListener("mouseleave", onMouseLeave, { passive: true });

    const resizeObserver = new ResizeObserver(() => {
      resize();
    });
    resizeObserver.observe(container);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      if (isVisible && !animationFrameId) {
        loop();
      }
    });
    intersectionObserver.observe(container);

    function draw() {
      if (!ctx || width === 0 || height === 0) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains("dark");
      const gridStep = 72; // Cartesian grid pitch
      
      const gridLineColor = isDark ? "rgba(148, 163, 184, 0.04)" : "rgba(15, 23, 42, 0.03)";
      const crosshairColor = isDark ? "rgba(148, 163, 184, 0.1)" : "rgba(15, 23, 42, 0.1)";
      const activeCrosshairColor = isDark ? "rgba(96, 165, 250, 0.45)" : "rgba(37, 99, 235, 0.5)";
      const activeGlow = isDark ? "rgba(96, 165, 250, 0.025)" : "rgba(37, 99, 235, 0.02)";

      // 1. Draw subtle Cartesian Grid Lines
      ctx.beginPath();
      ctx.strokeStyle = gridLineColor;
      ctx.lineWidth = 1;

      for (let x = 0; x <= width; x += gridStep) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
      }
      for (let y = 0; y <= height; y += gridStep) {
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
      }
      ctx.stroke();

      // 2. Draw Crosshair Intersection Markers & Proximity Telemetry
      const crossSize = 3.5;
      const mouseRadius = 180;
      const now = Date.now();

      // 3. Subtle Ambient Telemetry Scanline (Glides vertically down the grid every 9s)
      const scanPeriod = 9000;
      const scanProgress = (now % scanPeriod) / scanPeriod;
      const scanY = scanProgress * height;
      
      const scanGrad = ctx.createLinearGradient(0, scanY - 35, 0, scanY + 35);
      scanGrad.addColorStop(0, "transparent");
      scanGrad.addColorStop(0.5, isDark ? "rgba(96, 165, 250, 0.035)" : "rgba(37, 99, 235, 0.025)");
      scanGrad.addColorStop(1, "transparent");
      
      ctx.fillStyle = scanGrad;
      ctx.fillRect(0, scanY - 35, width, 70);

      ctx.beginPath();
      ctx.strokeStyle = isDark ? "rgba(96, 165, 250, 0.09)" : "rgba(37, 99, 235, 0.06)";
      ctx.lineWidth = 1;
      ctx.moveTo(0, scanY);
      ctx.lineTo(width, scanY);
      ctx.stroke();

      for (let x = 0; x <= width; x += gridStep) {
        for (let y = 0; y <= height; y += gridStep) {
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.hypot(dx, dy);

          if (mouse.active && dist < mouseRadius) {
            const factor = 1 - dist / mouseRadius;
            
            // Subtle ambient cell highlight near cursor
            ctx.fillStyle = activeGlow;
            ctx.fillRect(x - gridStep / 2, y - gridStep / 2, gridStep, gridStep);

            // Active crosshair
            ctx.strokeStyle = activeCrosshairColor;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(x - crossSize - factor * 2, y);
            ctx.lineTo(x + crossSize + factor * 2, y);
            ctx.moveTo(x, y - crossSize - factor * 2);
            ctx.lineTo(x, y + crossSize + factor * 2);
            ctx.stroke();
          } else {
            // Passive resting crosshair (every 2nd intersection for visual breathing room)
            if ((x / gridStep + y / gridStep) % 2 === 0) {
              ctx.strokeStyle = crosshairColor;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(x - crossSize, y);
              ctx.lineTo(x + crossSize, y);
              ctx.moveTo(x, y - crossSize);
              ctx.lineTo(x, y + crossSize);
              ctx.stroke();
            }
          }
        }
      }
    }

    function loop() {
      if (!isVisible) {
        animationFrameId = null;
        return;
      }

      // Smooth mouse interpolation
      if (mouse.active) {
        mouse.x += (mouse.targetX - mouse.x) * 0.15;
        mouse.y += (mouse.targetY - mouse.y) * 0.15;
      } else {
        mouse.x = -1000;
        mouse.y = -1000;
      }

      draw();
      animationFrameId = requestAnimationFrame(loop);
    }

    resize();
    loop();

    // Re-draw on theme toggle
    const observer = new MutationObserver(() => {
      draw();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  })();
</script>
